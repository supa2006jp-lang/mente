{
  "name": "forma-cad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js src/kernel-worker.js --bundle --minify --format=esm --outdir=dist --external:node:module && node scripts/copy-kernel.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/geometry.test.js tests/regions.test.js",
    "package:github": "npm run build && node scripts/package-github.mjs",
    "package:github:site": "npm run build && node scripts/package-github.mjs --site-only"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "esbuild": "^0.28.2",
    "jspdf": "^4.2.1",
    "opentype.js": "1.3.4",
    "qrcode": "1.5.4",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "playwright": "^1.63.0"
  }
}
